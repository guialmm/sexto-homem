      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.2,
      "position": [
        0,
        800
      ],
      "webhookId": "5c1b1e0a-2f6c-4f43-9a51-6b8f1c0a0004",
      "parameters": {
