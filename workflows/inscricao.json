    {
      "id": "b2",
      "name": "Confirmar inscrito",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        220,
        400
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "pgSextoHomem0001",
          "name": "Postgres · Sexto Homem"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "-- A malformed token simply matches nothing instead of erroring.\nUPDATE inscritos SET status = 'ativo', confirmado_em = now()\nWHERE status = 'pendente'\n  AND token_confirmacao::text = $1\nRETURNING nome;",
        "options": {
          "queryReplacement": "={{ [String($json.query.token ?? '')] }}"
        }
      }
    },
    {
      "id": "b3",
      "name": "Responder confirmação",
