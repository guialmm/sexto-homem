        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "-- POST only: mail scanners open links (GET) and must not unsubscribe anyone.\nUPDATE inscritos SET status = 'descadastrado', descadastrado_em = now()\nWHERE status <> 'descadastrado'\n  AND token_descadastro::text = $1\nRETURNING nome;",
        "options": {
