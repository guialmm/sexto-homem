      }
    },
    {
      "id": "d2n",
      "name": "Buscar última edição",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        220,
        800
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "pgSextoHomem0001",
          "name": "Postgres · Sexto Homem"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "-- The site shows the latest edition as a sample. Placeholders get neutral values:\n-- no subscriber's name or unsubscribe link ever leaves this query.\n-- The braces are built with chr(): n8n treats a literal double-brace in a query\n-- as one of its own expressions and strips it before Postgres sees it.\nWITH m AS (SELECT repeat(chr(123), 2) AS a, repeat(chr(125), 2) AS f)\nSELECT data, assunto,\n  replace(replace(replace(html,\n    m.a || 'NOME' || m.f, 'leitor'),\n    m.a || 'DESTAQUE_TIME' || m.f, ''),\n    m.a || 'DESCADASTRAR' || m.f, '#') AS html\nFROM edicoes, m\nWHERE status = 'enviada'\nORDER BY data DESC LIMIT 1;",
        "options": {}
      }
    },
    {
      "id": "d3n",
      "name": "Responder última edição",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        440,
        800
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json.html ? { ok: true, data: $json.data, assunto: $json.assunto, html: $json.html } : { ok: false } }}",
        "options": {}
      }
    }
